REP2:
COLOR 40: LOCATE 12, 14: PRINT "   PLAY GAME"
COLOR 48: LOCATE 13, 14: PRINT "   LOAD GAME"
COLOR 44: LOCATE 14, 14: PRINT "   SET KEYS"
COLOR 5: LOCATE 15, 14: PRINT "   INSTRUCTIONS"
COLOR 1: LOCATE 16, 14: PRINT "   EXIT GAME"
LINE (90, 59)-(220, 75), 1, B
LINE (89, 58)-(221, 76), 1, B
LINE (70, 50)-(250, 140), 2, B
PUT (95, 63), GUY
PUT (208, 63), GUY2
S = 88
PUT (100, S), ARROW
CHOICE = 1
REP: CLL = CLL + .1
IF CLL < 33 THEN CLL = 34
COLOR CLL: LOCATE 9, 17: PRINT "BALDY 2"
IF CLL > 55 THEN CLL = 33
A$ = UCASE$(INKEY$): SELECT CASE A$
CASE CHR$(0) + CHR$(80): SOUND 400, .4: PUT (100, S), BLANK, PSET: S = S + 8: PUT (100, S), ARROW: CHOICE = CHOICE + 1
CASE CHR$(0) + CHR$(72): SOUND 400, .4: PUT (100, S), BLANK, PSET: S = S - 8: PUT (100, S), ARROW: CHOICE = CHOICE - 1
CASE CHR$(13): GOTO CHOOSE
END SELECT
IF CHOICE = 0 THEN PUT (100, S), BLANK, PSET: S = 117: PUT (100, S), ARROW: CHOICE = 5
IF CHOICE = 6 THEN PUT (100, S), BLANK, PSET: S = 87: PUT (100, S), ARROW: CHOICE = 1
GOTO REP

