12000 ' Calculate number of video pages
12010 DEF SEG = &H40
12020 LOWBYTE% = PEEK(&H4C): HIGHBYTE% = PEEK(&H4D)
12030 PAGESIZE% = LOWBYTE% + 256 * HIGHBYTE%
12040 PAGESIZE% = PAGESIZE% + (255 AND -PAGESIZE%)
12050 PAGES = INT(65536 / PAGESIZE%)
12060 DEF SEG
12070 RETURN
