DEFSNG Z
SUB Back (sped, orw, words$)
mi = LEN(words$)
cent = 21 - INT(LEN(words$) / 2) + (mi)
   FOR im = mi TO 1 STEP -1
    FOR DELAY = 1 TO sped: NEXT
    LOCATE orw, cent
    IF im > 1 THEN PRINT MID$(words$, im, 1)
    IF im = 1 THEN PRINT LEFT$(words$, 1)
    cent = cent - 1
   NEXT
END SUB

SUB Center (row, text$)
cent = 19 - INT(LEN(text$) / 2)
LOCATE row, cent: PRINT text$
END SUB

SUB Slide (speed, row, text$)
mi = LEN(text$)
cent = 21 - INT(LEN(text$) / 2)
 FOR im = 1 TO mi
   FOR DELAY = 1 TO speed: NEXT
   LOCATE row, cent
   IF im > 1 THEN PRINT MID$(text$, im, 1)
   IF im = 1 THEN PRINT LEFT$(text$, 1)
   cent = cent + 1
  NEXT
END SUB

SUB Slide2 (deeps, wor, speedoffadein, tet$)
SCREEN 13
mi = LEN(tet$)
cent = 19 - INT(LEN(tet$) / 2)
 FOR im = 1 TO mi
     FOR DELAY = 1 TO deeps: NEXT
     LOCATE wor, cent
     FOR fadein = 16 TO 31
       COLOR fadein
       FOR DELAY = 1 TO speedoffadein: NEXT
       LOCATE wor, cent
       IF im > 1 THEN PRINT MID$(tet$, im, 1)
       IF im = 1 THEN PRINT LEFT$(tet$, 1)
     NEXT
   cent = cent + 1
 NEXT
END SUB

DEFINT Z
SUB Stars (zdir)
SHARED Ztotal
FOR Znum = 1 TO Ztotal
  IF POINT(Zstara(Znum), Zstarx(Znum)) = 150 THEN PSET (Zstara(Znum), Zstarx(Znum)), 256
   IF zdir < 4 THEN Zstara(Znum) = Zstara(Znum) + Zspeeda(Znum)
   IF zdir > 4 AND zdir <> 8 THEN Zstara(Znum) = Zstara(Znum) - Zspeeda(Znum)
   SELECT CASE zdir
     CASE 1: Zstarx(Znum) = Zstarx(Znum) + 1
             IF Zstarx(Znum) >= 200 THEN Zstarx(Znum) = 1: Zstara(Znum) = INT(RND * 320) + 1
     CASE 2: Zstara(Znum) = Zstara(Znum) + 1
             IF Zstarx(Znum) <= 0 THEN Zstarx(Znum) = 200: Zstara(Znum) = INT(RND * 320) + 1
     CASE 3: Zstarx(Znum) = Zstarx(Znum) - 1
             IF Zstarx(Znum) <= 0 THEN Zstarx(Znum) = 200: Zstara(Znum) = INT(RND * 320) + 1
     CASE 4: Zstarx(Znum) = Zstarx(Znum) + Zspeeda(Znum)
             IF Zstarx(Znum) >= 200 THEN Zstara(Znum) = INT(RND * 320) + 1: Zstarx(Znum) = 0
     CASE 5: Zstarx(Znum) = Zstarx(Znum) + 1
             IF Zstarx(Znum) >= 200 THEN Zstara(Znum) = INT(RND * 320) + 1: Zstarx(Znum) = 0
     CASE 6: IF Zstara(Znum) <= 0 THEN Zstarx(Znum) = INT(RND * 200) + 1: Zstara(Znum) = 320
     CASE 7: Zstarx(Znum) = Zstarx(Znum) - 1
             IF Zstarx(Znum) <= 0 THEN Zstara(Znum) = INT(RND * 320) + 1: Zstarx(Znum) = 200
     CASE 8: Zstarx(Znum) = Zstarx(Znum) - Zspeeda(Znum)
             IF Zstarx(Znum) = 0 THEN Zstara(Znum) = INT(RND * 320) + 1: Zstarx(Znum) = 200
    END SELECT
   IF zdir < 4 THEN IF Zstara(Znum) >= 320 THEN Zstarx(Znum) = INT(RND * 200) + 1: Zstara(Znum) = 1
   IF zdir > 4 THEN IF zdir <> 8 THEN IF Zstara(Znum) <= 0 THEN Zstarx(Znum) = INT(RND * 200) + 1: Zstara(Znum) = 320
   IF POINT(Zstara(Znum), Zstarx(Znum)) = 0 OR POINT(Zstara(Znum), Zstarx(Znum)) = 150 THEN PSET (Zstara(Znum), Zstarx(Znum)), 150
  NEXT
END SUB

