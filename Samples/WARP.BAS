SUB DrawLine (X1, Y1, X2, Y2, C, MASK())
DIM O AS LONG

DX = ABS(X2 - X1)
DY = ABS(Y2 - Y1)

SX = SGN(X2 - X1)
SY = SGN(Y2 - Y1)

E = DX - DY

X = X1
Y = Y1
O = Y * 640& + X

OSY = SY * 640

DIM MASKBITVALUE(15) AS INTEGER

MASKBITVALUE(0) = -32768
MASKBITVALUE(15) = 1

FOR I = 14 TO 1 STEP -1
  MASKBITVALUE(I) = MASKBITVALUE(I + 1) * 2
NEXT I

DO
  IF X >= 0 AND Y >= 0 AND X < SCREENWIDTH AND Y < SCREENWIDTH THEN
    MASKI = O \ 16
    MASKBIT = O AND 15

    IF (MASK(MASKI) AND MASKBIT) = 0 THEN PSET (X, Y), C
  END IF

  E2 = E + E

  IF E2 > -DY THEN E = E - DY: X = X + SX: O = O + SX
  IF E2 < DX THEN E = E + DX: Y = Y + SY: O = O + OSY
LOOP UNTIL X = X2 AND Y = Y2
END SUB

DEFSNG A-Z
SUB DrawMesh
GRIDEXTENT = .5 * GRIDSIZE
COORDINATESCALE = 10 / GRIDEXTENT ' CalculateWarpField expects [-10, 10]

OX = GRIDEXTENT
OY = -GRIDEXTENT

DOX = -.5
DOY = 0

DO
  OX = OX + DOX
  OY = OY + DOY

  X = OX
  Y = OY

  DX = .5
  DY = 0

  FIRST = -1

  DO
    Z = CalculateWarpField(X * COORDINATESCALE, Y * COORDINATESCALE)

    SX = INT(SCREENCX + (X + Y) * 5)
    SY = INT(SCREENCY - (X - Y) * 2 - Z * 5)

    IF FIRST THEN
      FIRST = 0
    ELSE
      FOR XX = PX + 1 TO SX
        YY = (XX - PX) * (SY - PY) / (SX - PX) + PY
        LINE (XX, YY)-(XX, 479), 0
      NEXT XX

      C = 1 + ABS(Z) * SHADINGSCALE
      IF C > 15 THEN C = 15

      LINE (PX, PY)-(SX, SY), C
    END IF

    PX = SX
    PY = SY

    X = X + DX
    Y = Y + DY

    SWAP DX, DY
  LOOP UNTIL X > GRIDEXTENT OR Y > GRIDEXTENT

  IF OX = -GRIDEXTENT THEN DOX = 0: DOY = .5
LOOP UNTIL OY = GRIDEXTENT
END SUB

SUB DrawModel (PRESERVEGRID, AMBIENTLIGHT, LIGHTINTENSITY)
' Read model from DATA. Compute distance from camera (isometric) as we go.
DIM X(1000), Y(1000), Z(1000), PZ(1000)
DIM NUMPOINTS AS INTEGER

DO
  I = NUMPOINTS
  NUMPOINTS = NUMPOINTS + 1

  READ Y(I), X(I), Z(I)

  X(I) = X(I) * MODELSCALE
  Y(I) = Y(I) * MODELSCALE
  Z(I) = Z(I) * MODELSCALE

  PZ(I) = -(X(I) + Y(I))
LOOP UNTIL X(I) = 0 AND Y(I) = 0 AND Z(I) = 0

' Just in case, ignore any stray points that don't add up to a triangle.
NUMPOINTS = NUMPOINTS - (NUMPOINTS MOD 3)

' Sort the triangles back to front
FOR I = 0 TO NUMPOINTS - 1 STEP 3
  IF PZ(I + 1) < PZ(I) THEN PZ(I) = PZ(I + 1)
  IF PZ(I + 2) < PZ(I) THEN PZ(I) = PZ(I + 2)
NEXT I

FOR I = 3 TO NUMPOINTS - 1 STEP 3
  FARTHESTI = I - 3
  FARTHESTPZ = PZ(FARTHESTI)

  FOR J = I TO NUMPOINTS - 1 STEP 3
    IF PZ(J) > FARTHESTPZ THEN FARTHESTPZ = PZ(J): FARTHESTI = J
  NEXT J

  IF FARTHESTI >= I THEN
    FOR J = 0 TO 2
      SWAP X(I - 3 + J), X(FARTHESTI + J)
      SWAP Y(I - 3 + J), Y(FARTHESTI + J)
      SWAP Z(I - 3 + J), Z(FARTHESTI + J)
      SWAP PZ(I - 3 + J), PZ(FARTHESTI + J)
    NEXT J
  END IF
NEXT I

' Capture mask if we need to preserve the grid.
DIM MASK(19199) AS INTEGER

IF PRESERVEGRID THEN
  O = 0
  FOR Y = 0 TO 479
    FOR X = 0 TO 639 STEP 16
      BIT = -32768
      FOR XX = 0 TO 15
        IF POINT(X + XX, Y) THEN MASK(O) = MASK(O) OR BIT
        IF XX THEN BIT = BIT \ 2 ELSE BIT = 16384
      NEXT XX
      O = O + 1
    NEXT X
  NEXT Y
END IF

' For each of the triangles in this order, compute its normal, Phong light it and draw its edges, respecting PRESERVEGRID

LIGHTX = -10
LIGHTY = 20
LIGHTZ = 15

VIEWX = -1 ' Isometric projection: Direction toward camera is the same everywhere
VIEWY = 1
VIEWZ = 1

Normalize VIEWX, VIEWY, VIEWZ

DIM COLOUR AS INTEGER

FOR I = 0 TO NUMPOINTS - 1 STEP 3
  CX = (X(I) + X(I + 1) + X(I + 2)) / 3
  CY = (Y(I) + Y(I + 1) + Y(I + 2)) / 3
  CZ = (Z(I) + Z(I + 1) + Z(I + 2)) / 3

  ' Compute the normal by normalizing the cross product of two edges
  UX = X(I + 1) - X(I): UY = Y(I + 1) - Y(I): UZ = Z(I + 1) - Z(I)
  VX = X(I + 2) - X(I): VY = Y(I + 2) - Y(I): VZ = Z(I + 2) - Z(I)

  NX = UY * VZ - UZ * VY
  NY = UZ * VX - UX * VZ
  NZ = UX * VY - UY * VX

  Normalize NX, NY, NZ

  ' Phong lighting: Diffuse lighting based on how directly the polygon faces the light,
  ' specular lighting based on how close the polygon is to reflecting light directly to
  ' the camera.
  TLX = LIGHTX - CX: TLY = LIGHTY - CY: TLZ = LIGHTZ - CZ
  Normalize TLX, TLY, TLZ

  DIFFUSE = 2 * (NX * TLX + NY * TLY + NZ * TLZ)

  RX = NX * DIFFUSE - TLX
  RY = NY * DIFFUSE - TLY
  RZ = NZ * DIFFUSE - TLZ

  DIFFUSE = DIFFUSE * .5
  IF DIFFUSE < 0 THEN DIFFUSE = 0

  Normalize RX, RY, RZ

  SPECULAR = RX * VIEWX + RY * VIEWY + RZ * VIEWZ
  IF SPECULAR < 0 THEN SPECULAR = 0

  SPECULAR = SPECULAR ^ 16

  LIGHT = AMBIENTLIGHT + LIGHTINTENSITY * (DIFFUSE + SPECULAR)

  COLOUR = LIGHT * 15 + 1
  IF COLOUR < 1 THEN COLOUR = 1
  IF COLOUR > 15 THEN COLOUR = 15

  DrawTriangle3D X(I), Y(I), Z(I), X(I + 1), Y(I + 1), Z(I + 1), X(I + 2), Y(I + 2), Z(I + 2), (COLOUR), MASK()
NEXT I
END SUB

SUB DrawTriangle3D (X1, Y1, Z1, X2, Y2, Z2, X3, Y3, Z3, COLOUR AS INTEGER, MASK() AS INTEGER)
DIM SX1 AS INTEGER, SY1 AS INTEGER, SZ1 AS INTEGER
DIM SX2 AS INTEGER, SY2 AS INTEGER, SZ2 AS INTEGER
DIM SX3 AS INTEGER, SY3 AS INTEGER, SZ3 AS INTEGER

D1 = SQR((X2 - X1) ^ 2 + (Y2 - Y1) ^ 2 + (Z2 - Z1) ^ 2)
D2 = SQR((X3 - X2) ^ 2 + (Y3 - Y2) ^ 2 + (Z3 - Z2) ^ 2)
D3 = SQR((X1 - X3) ^ 2 + (Y1 - Y3) ^ 2 + (Z1 - Z3) ^ 2)

PERIMETER = D1 + D2 + D3

IF PERIMETER <= MODELCOARSENESS THEN
  SX1 = INT(SCREENCX + (X1 + Y1) * 5)
  SY1 = INT(SCREENCY - (X1 - Y1) * 2 - Z1 * 5)

  SX2 = INT(SCREENCX + (X2 + Y2) * 5)
  SY2 = INT(SCREENCY - (X2 - Y2) * 2 - Z2 * 5)

  SX3 = INT(SCREENCX + (X3 + Y3) * 5)
  SY3 = INT(SCREENCY - (X3 - Y3) * 2 - Z3 * 5)

  DrawLine SX1, SY1, SX2, SY2, COLOUR, MASK()
  DrawLine SX1, SY1, SX3, SY3, COLOUR, MASK()
  DrawLine SX2, SY2, SX3, SY3, COLOUR, MASK()
ELSE
  ' Subdivide the triangle for a bit of extra density
  MX1 = (X2 + X3) * .5: MY1 = (Y2 + Y3) * .5: MZ1 = (Z2 + Z3) * .5
  MX2 = (X3 + X1) * .5: MY2 = (Y3 + Y1) * .5: MZ2 = (Z3 + Z1) * .5
  MX3 = (X1 + X2) * .5: MY3 = (Y1 + Y2) * .5: MZ3 = (Z1 + Z2) * .5

  DrawTriangle3D X1, Y1, Z1, MX2, MY2, MZ2, MX3, MY3, MZ3, COLOUR, MASK()
  DrawTriangle3D X2, Y2, Z2, MX3, MY3, MZ3, MX1, MY1, MZ1, COLOUR, MASK()
  DrawTriangle3D X3, Y3, Z3, MX1, MY1, MZ1, MX2, MY2, MZ2, COLOUR, MASK()
END IF
END SUB

SUB Normalize (X, Y, Z)
LENGTH = SQR(X ^ 2 + Y ^ 2 + Z ^ 2)
IF LENGTH > .00001 THEN
  SCALE = 1 / LENGTH
  X = X * SCALE
  Y = Y * SCALE
  Z = Z * SCALE
END IF
END SUB
