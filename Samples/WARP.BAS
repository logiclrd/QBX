FUNCTION CalculateWarpField# (X, Y)
' X and Y are expected to be in [-10, 10]
' Z is hardcoded to be 0

R = SQR(X ^ 2 + Y ^ 2)

' Exact centre is mathematically zero. Short-circuit (prevents explosion/division by zero).
IF R < .00001 THEN EXIT FUNCTION

' Approximated hyperbolic tangent shape function derivative
' Math: d/dr( f(r) ) where space contracts in front, expands behind
' We approximate the peak intensity at the bubble wall boundary
SHAPE = -BUBBLESIGMA * EXP(BUBBLESIGMA * (R - BUBBLERADIUS)) / ((EXP(BUBBLESIGMA * (R - BUBBLERADIUS)) + 1) ^ 2)

' The Expansion Scalar (Theta) calculation
CalculateWarpField = GRIDZSCALE * (Y / R) * SHAPE
END FUNCTION

